rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all to prevent unmapped read/write
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check collection for connection testing
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || resource.data.id == userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) 
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.role in ['operator', 'auditor', 'admin'];
      allow update: if isOwner(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'role']);
      allow delete: if false;
    }

    // Threats Collection
    match /threats/{threatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(threatId)
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.severity in ['Critical', 'High', 'Medium', 'Low', 'Benign']
        && request.resource.data.threatType is string
        && request.resource.data.zkProofHash is string;
      allow update, delete: if false;
    }

    // Hugging Face Models Collection
    match /hf_models/{modelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(modelId)
        && request.resource.data.importedByUid == request.auth.uid
        && request.resource.data.modelId is string
        && request.resource.data.pipelineTag is string;
      allow update: if isSignedIn()
        && resource.data.importedByUid == request.auth.uid
        && request.resource.data.importedByUid == resource.data.importedByUid;
      allow delete: if isSignedIn() && resource.data.importedByUid == request.auth.uid;
    }

    // Audit Logs Collection (Immutable append-only)
    match /audit_logs/{auditId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(auditId)
        && request.resource.data.category in ['detected_intrusion', 'model_training', 'access_control']
        && request.resource.data.recordHash is string
        && request.resource.data.action is string;
      allow update, delete: if false;
    }
  }
}
